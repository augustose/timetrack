<?xml version="1.0" encoding="UTF-8"?>
<!--
  Headless alternative: runs the CLI sampler instead of the menu bar app.
  Use this only if you do not want the menu bar icon. Install with:
    sed 's|__CLI_PATH__|'"$HOME"'/.local/bin/timetrack|g; s|__LOG_DIR__|'"$HOME"'/.local/state/timetrack|g' \
      scripts/ca.senet.timetrack.plist.in > ~/Library/LaunchAgents/ca.senet.timetrack.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ca.senet.timetrack.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ca.senet.timetrack</string>
    <key>ProgramArguments</key>
    <array>
        <string>__CLI_PATH__</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/timetrack.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/timetrack.err.log</string>
</dict>
</plist>
